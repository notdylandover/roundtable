# Copy to `.env.local`. Both `next dev` and `wrangler dev` (npm run dev:party) read it.

# Required. Signs session cookies and the short-lived tokens the party worker verifies.
# Use the SAME value for the Next.js app and the party worker (`npx wrangler secret put AUTH_SECRET`).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional. Discord OAuth (https://discord.com/developers/applications → OAuth2).
# Add the redirect URL `<your site>/api/auth/discord/callback` (e.g. http://localhost/api/auth/discord/callback).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional override when the public URL differs from the request URL (e.g. behind a proxy).
DISCORD_REDIRECT_URI=

# Optional override for the party worker host. Defaults to roundtable-api.dylandover.dev in production builds and localhost:1999 in development.
NEXT_PUBLIC_PARTYKIT_HOST=
