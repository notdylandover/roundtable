# Copy to `.env.local`. Both `next dev` and `partykit dev` read it.

# Required. Signs session cookies and the short-lived tokens PartyKit verifies.
# Use the SAME value for the Next.js app and the PartyKit worker (`npx partykit env add AUTH_SECRET`).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional. Discord OAuth (https://discord.com/developers/applications → OAuth2).
# Add the redirect URL `<your site>/api/auth/discord/callback` (e.g. http://localhost/api/auth/discord/callback).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional override when the public URL differs from the request URL (e.g. behind a proxy).
DISCORD_REDIRECT_URI=

# PartyKit host for the browser. Defaults to localhost:1999.
NEXT_PUBLIC_PARTYKIT_HOST=
